            <AlertCircle size={16} />
            {toast}
          </div>
        </div>
      )}

      {/* GLOBAL FIXED BACKGROUND — matches trainer-register */}
      <div className="fixed inset-0 z-0 pointer-events-none will-change-transform transform-gpu">
        <svg
          ref={trackRef}
