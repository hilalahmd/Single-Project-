                <button className="w-full py-2.5 rounded-full bg-white/10 text-white text-sm font-bold hover:bg-[#2563EB] transition-colors">
                  View Profile
                </button>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  )
}
