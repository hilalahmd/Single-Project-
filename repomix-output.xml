              className="w-full py-4 border-2 border-[rgba(255,255,255,0.1)] bg-white/5 text-white text-[15px] font-bold rounded-full group-hover:border-[#ff6b1a]/50 transition-colors uppercase tracking-wide cursor-pointer" 
