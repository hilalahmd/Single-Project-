    <div className="max-w-7xl mx-auto relative overflow-hidden flex h-auto min-h-[calc(100vh-6rem)] -m-4 sm:-m-6 lg:-m-8 p-4 sm:p-6 lg:p-8 bg-[#F9FAFB]">
