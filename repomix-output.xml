            <line x1="50%" y1="0" x2="110%" y2="100%" stroke="white" strokeWidth="2"  strokeDasharray="10 10" opacity="0.30" />
            <line x1="0" y1="30%" x2="100%" y2="30%" stroke="white" strokeWidth="1" opacity="0.15" />
