          specialties: data.specialties || [],
          bio: data.bio || 'No bio added yet.',
          heroImage: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80',
